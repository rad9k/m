<my:UXItem x:Class="m0.ZeroTypes.UX.OvalItem"
             xmlns:my="clr-namespace:m0.ZeroTypes.UX"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             >
    
        <Grid>
            <Ellipse x:Name="Elipse" Stretch="Fill" Margin="0" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" StrokeThickness="1"/>
            <TextBlock x:Name="Title" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
        </Grid>

</my:UXItem>
