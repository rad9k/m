<my:UXItem x:Class="m0.ZeroTypes.UX.MultiContainerSubItem"
             xmlns:my="clr-namespace:m0.ZeroTypes.UX"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             SizeChanged="UserControl_SizeChanged">

    <DockPanel x:Name="Panel" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
        <DockPanel DockPanel.Dock="Top" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
            <TextBlock Name="Label" DockPanel.Dock="Left"  />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Background="Red">
                <TextBlock>code</TextBlock>
                <ToggleButton Name="CodeToggle" />
            </StackPanel>
        </DockPanel>
        <Canvas x:Name="canvas" />
    </DockPanel>
        
</my:UXItem>
