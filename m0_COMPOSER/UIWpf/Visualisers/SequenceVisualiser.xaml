<UserControl xmlns:Controls="clr-namespace:m0_COMPOSER.UIWpf.Visualisers.Controls"  x:Class="m0_COMPOSER.UIWpf.Visualisers.SequenceVisualiser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:m0_COMPOSER.UIWpf.Visualisers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" >
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Name="NewButton" ToolTip="Add new note" Click="NewButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,/m0;Component/_resources/basic/pen.png" Width="15" Height="15"/>
                        <TextBlock Margin="3,0,0,0">New</TextBlock>
                    </StackPanel>
                </Button>
                <Button Name="EraseButton" ToolTip="Erase note" Click="EraseButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,/m0;Component/_resources/basic/eraser.png" Width="15" Height="15"/>
                        <TextBlock Margin="3,0,0,0">Erase</TextBlock>
                    </StackPanel>
                </Button>
                <Button Name="SelectButton" ToolTip="Select multiple notes" Click="SelectButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,/m0;Component/_resources/basic/pointer.png" Width="15" Height="15"/>
                        <TextBlock Margin="3,0,0,0">Select</TextBlock>
                    </StackPanel>
                </Button>
                <Button Name="ExtendButton" ToolTip="Extend the sequence length" Click="ExtendButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,/m0;Component/_resources/basic/extend.png" Width="15" Height="15"/>
                        <TextBlock Margin="3,0,0,0">Extend</TextBlock>
                    </StackPanel>
                </Button>
                <Separator/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox Name="SnapToGridComboBox" SelectionChanged="SnapToGridComboBox_SelectionChanged">
                        <ComboBoxItem IsSelected="True">1 bar</ComboBoxItem>
                        <ComboBoxItem>1/2 bar</ComboBoxItem>
                        <ComboBoxItem>1/4 bar</ComboBoxItem>
                        <ComboBoxItem>1/8 bar</ComboBoxItem>
                        <ComboBoxItem>1/16 bar</ComboBoxItem>
                        <ComboBoxItem>1/32 bar</ComboBoxItem>
                        <ComboBoxItem>no snap</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">snap to grid</TextBlock>
                </StackPanel>
            </ToolBar>
        </ToolBarTray>
        <Controls:ZoomScrollView x:Name="ZoomScrollView"/>
    </DockPanel>
</UserControl>
