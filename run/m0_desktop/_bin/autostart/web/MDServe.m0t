System\FormalTextLanguage\ZeroCode_VertexAndManyLines
"MDServe"
	import @System\Lib\Std direct meta
	function "MDServeHandler" (@VertexType "startDir", @String "url")
		if url == "/"
			return @@getIndex[]
			
		if url == "/script.js"
			return @@getScript[]
			
		if url == "/tree.json"
			return @@getTreeJson[startDir]
			
		return "ok"
		
	function "getIndex" ()
		return Start\:web\:'index.html'\Content
		
	function "getScript" ()
		return Start\:web\:'script.js'\Content
		
	"Meta"
		"MDServeCache"
		"id"
		"title"
		"children"
		
	"TestData"
		"Meta"
			"id"
			"title"
			"children"
		"Json"
			""
				<@TestData\Meta\id :: "intro">
				<@TestData\Meta\title :: "KUPA">
				<@TestData\Meta\children :: "">
					<@TestData\Meta\id :: "getting">
					<@TestData\Meta\title :: "Getting Started">
				<@TestData\Meta\children :: "">
					<@TestData\Meta\id :: "overview">
					<@TestData\Meta\title :: "System Overview">
			""
				<@TestData\Meta\id :: "api">
				<@TestData\Meta\title :: "API Reference">
				<@TestData\Meta\children :: "">
					<@TestData\Meta\id :: "endpoints">
					<@TestData\Meta\title :: "Endpoints">
				<@TestData\Meta\children :: "">
					<@TestData\Meta\id :: "models">
					<@TestData\Meta\title :: "Data Models">	
	function "getTreeJson" (@String "startDir")
		variable "startDirId" @String
		variable "treeTempVertex" @VertexType
		variable "v" @VertexType
		
		startDirId = startDir\FullFilename
		
		if :Temp\:'(startDirId)'<> != "0"
			return :Temp\:'(startDirId)'\json:
			
		v = @@getTree[startDir, "True"]
		v +< :System\:Lib\:StdView\:VertexToJson :: ""
			
		:Temp +< @@Meta\MDServeCache :: %startDirId
		treeTempVertex = :Temp\:'(startDirId)'
		
		treeTempVertex +< "json" :: v\VertexToJson
		
		return treeTempVertex\json
		
	function "getTree" (@VertexType "startDir")
		variable "v" @VertexType
		
		v +< @@getTree_Recursive[startDir, "True", ""]
		
		:Temp +< v
		
		return @@TestData\Json
		
	function "getTree_Recursive"(@VertexType "dir", @Boolean isFirstLevel, @String "path")
		variable "v" @VertexType
		variable "f" @String
		variable "c" @VertexType
		
		c = dir
		c += isFirstLevel
		:Temp +< "exe" :: @@Concatenate[c]
		
		if isFirstLevel == "True"
			foreach "e" in dir\
				if (e\$Is:Directory<> != "0") | (e\$Is:File<> != "0")
					v +< ::> @@getTree_Recursive[e, "False"]
			return v\
		
		if isFirstLevel == "False"
			:Temp +< "false"
			f = path
			f += @@Replace[dir\Filename, " ", "_"]
			v +< @@Meta\id :: @@Concatenate[f]
			v +< @@Meta\title :: dir\Filename
			idCnt = idCnt + "1"
			
			f = path
			f += "-"
			f = @@Concatenate[f]
			
			if dir\$Is:Directory<> != "0"
				foreach "e" in dir\
					if (e\$Is:Directory<> != "0") | (e\$Is:File<> != "0")
						v +< @@Meta\children ::> @@getTree_Recursive[e, "False", f]
		
		return v