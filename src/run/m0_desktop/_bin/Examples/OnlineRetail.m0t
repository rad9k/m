				import @Start:\Examples\'OnlineRetailDB.m0t'\$Store:\OnlineRetailDB direct meta

				variable "x" @Vertex

				function "CreateUser" @String(@String "name", @String "surname", @String "email", @String "password")
					variable "myShop" @Vertex
					myShop = @@Start:\Examples\'OnlineRetailDB.m0t'\$Store:\OnlineRetailDB\MyShop

					if myShop\User{Email:'(email)'}<> > "0"
						return "USER EXIST"

					$stack +< @@OnlineRetail\OnlineRetailModel\Shop\User :: ""
					User = new @@OnlineRetail\OnlineRetailModel\User[]
					User\BusinessID = @@System\Lib\Std\CreateURN[@@OnlineRetail\OnlineRetailModel\User\BusinessID]
					User\Name = name
					User\Surname = surname
					User\Email = email
					User\PasswordHash = @@System\Lib\Cryptography\HashPassword[password]

					@@Start:\Examples\'OnlineRetailDB.m0t'\$Store:\OnlineRetailDB\MyShop <<copy<< User

					return "OK"

				function "Login" @String(@String "email", @String "password")
					variable "PasswordHash" @String
					variable "user" @Vertex
					variable "myShop" @Vertex
					myShop = @@Start:\Examples\'OnlineRetailDB.m0t'\$Store:\OnlineRetailDB\MyShop

					user = myShop\User{Email:'(email)'}

					if user<> == "1"
						if @@System\Lib\Cryptography\'VerifyPassword'[password, user\PasswordHash]
							$stack +< @@OnlineRetail\OnlineRetailModel\User\Token :: ""
							Token = new @@OnlineRetail\OnlineRetailModel\Token[]
							Token\TokenString = @@System\Lib\Cryptography\GenerateToken[]
							Token\Expiry = @@System\Lib\Std\DateTime_Now[]
							Token\Expiry.Add[new @@TimeSpan["0", "0", "0", "1"]]
							user <<copy<< Token

							return Token\TokenString

					return "ERROR"

				function "GetCategories" @OnlineRetail\OnlineRetailModel\Category()
					variable "myShop" @Vertex
					myShop = @@Start:\Examples\'OnlineRetailDB.m0t'\$Store:\OnlineRetailDB\MyShop

					return myShop\Category

				function "GetProducts" @OnlineRetail\OnlineRetailModel\Product(@String "categoryBusinessID")
					variable "myShop" @Vertex
					variable "product" @OnlineRetail\OnlineRetailModel\Product
					myShop = @@Start:\Examples\'OnlineRetailDB.m0t'\$Store:\OnlineRetailDB\MyShop

					product = myShop\Category{BusinessID:'(categoryBusinessID)'}\Product

					return product

				function "GetUser" @OnlineRetail\OnlineRetailModel\User(@String "tokenString")
					variable "myShop" @Vertex
					variable "token" @OnlineRetail\OnlineRetailModel\Token
					myShop = @@Start:\Examples\'OnlineRetailDB.m0t'\$Store:\OnlineRetailDB\MyShop

					token = myShop\User\Token{TokenString:'(tokenString)'}

					if @@System\Lib\Std\DateTime_Now[].IsEarlierThan[token\Expiry]
						return token#Token

					return ~00

				function "GetOrders" @OnlineRetail\OnlineRetailModel\Order(@String "tokenString")
					variable "user" @OnlineRetail\OnlineRetailModel\User

					user = @@OnlineRetail\BackendService\Service\GetUser[tokenString]

					if user<> == "1"
						return user\Order

					return "ERROR"

				function "CreateOrder" @String(@String "tokenString")
					variable "user" @OnlineRetail\OnlineRetailModel\User

					user = @@OnlineRetail\BackendService\Service\GetUser[tokenString]

					if user<> == "1"
						$stack +< @@OnlineRetail\OnlineRetailModel\User\Order :: ""
						Order = new @@OnlineRetail\OnlineRetailModel\Order[]
						Order\BusinessID = @@System\Lib\Std\CreateURN[@@OnlineRetail\OnlineRetailModel\Order\BusinessID]
						Order\State = @@OnlineRetail\OnlineRetailModel\OrderState\CollectingOrder

						user <<copy<< Order

						return Order\BusinessID

					return "ERROR"

