						Address\AddressLine1 = addressLine1
						Address\AddressLine2 = addressLine2
						Address\PostalCode = postalCode
						Address\City = city
						Address\Country = country

						user <<copy<< Address

						return Address\BusinessID

					return "ERROR"

				function "DeleteAddress" (@String "tokenString", @String "addressBusinessID")
					variable "user" @OnlineRetail\OnlineRetailModel\User
					variable "address" @OnlineRetail\OnlineRetailModel\Address

					user = @@OnlineRetail\BackendService\Service\GetUser[tokenString]

