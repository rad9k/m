<Application x:Class="m0_RUN.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:m0.UIWpf"
             ThemeMode="None">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ResourceDictionaryWhite.xaml"/>
                <ResourceDictionary Source="iOSStyleTogglebutton.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Window">
                <Setter Property="Icon" Value="pack://application:,,,/m0_desktop;component/Images/m0.ico"/>
                <Setter Property="ui:UiScale.TrackWindowSize" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Window">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding Scale, Source={x:Static ui:UiScale.Instance}}"
                                                    ScaleY="{Binding Scale, Source={x:Static ui:UiScale.Instance}}"/>
                                </Border.LayoutTransform>
                                <Grid>
                                    <AdornerDecorator>
                                        <ContentPresenter/>
                                    </AdornerDecorator>
                                    <ResizeGrip x:Name="WindowResizeGrip"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Visibility="Collapsed"
                                                IsTabStop="False"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                        <Condition Property="WindowState" Value="Normal"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
