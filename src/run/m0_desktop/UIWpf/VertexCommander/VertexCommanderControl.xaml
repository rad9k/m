<UserControl x:Class="m0.UIWpf.VertexCommander.VertexCommanderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="520"
    d:DesignWidth="980"
    Background="{StaticResource 0BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{StaticResource 0VeryVeryLightForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource 0BackgroundBrush}"/>
        </Style>

        <Style x:Key="PlaceholderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource 0GrayBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="GripSplitterStyle" TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="{StaticResource 0GripBrush}"/>
            <Setter Property="ShowsPreview" Value="False"/>
        </Style>

        <ControlTemplate x:Key="VertexCommanderExpanderButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Rectangle Fill="Transparent"/>
                    <Ellipse x:Name="Circle"
                        Stroke="DarkGray"
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                    <Path x:Name="Arrow"
                        Data="M 1,1.5 L 4.5,5 8,1.5"
                        Stroke="#FF666666"
                        StrokeThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Arrow"
                                    Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                    To="180"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Arrow"
                                    Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                    To="0"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Stroke" Value="#FF3C7FB1" TargetName="Circle"/>
                    <Setter Property="Stroke" Value="#222" TargetName="Arrow"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="true">
                    <Setter Property="Stroke" Value="#FF526C7B" TargetName="Circle"/>
                    <Setter Property="StrokeThickness" Value="1.5" TargetName="Circle"/>
                    <Setter Property="Stroke" Value="#FF003366" TargetName="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="VertexCommanderHorizontalExpanderTemplate" TargetType="{x:Type Expander}">
            <DockPanel>
                <ContentPresenter DockPanel.Dock="Left"
                    ContentSource="Header"
                    TextElement.Foreground="{StaticResource 0ForegroundBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"/>
                <ToggleButton x:Name="ExpanderButton"
                    DockPanel.Dock="Left"
                    Template="{StaticResource VertexCommanderExpanderButtonTemplate}"
                    IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                    OverridesDefaultStyle="True"
                    Padding="1.5,0"/>
                <ContentPresenter x:Name="ExpanderContent"
                    ContentSource="Content"
                    DockPanel.Dock="Right">
                    <ContentPresenter.LayoutTransform>
                        <ScaleTransform ScaleY="0"/>
                    </ContentPresenter.LayoutTransform>
                </ContentPresenter>
            </DockPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ExpanderContent"
                                    Storyboard.TargetProperty="(ContentPresenter.LayoutTransform).(ScaleTransform.ScaleY)"
                                    To="1"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ExpanderContent"
                                    Storyboard.TargetProperty="(ContentPresenter.LayoutTransform).(ScaleTransform.ScaleY)"
                                    To="0"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="7"/>
            <ColumnDefinition Width="*" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,3,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="100"/>
                <RowDefinition Height="7"/>
                <RowDefinition Height="8*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionBorderStyle}" MinHeight="26" Margin="0,0,0,3">
                <ContentControl x:Name="LeftQueryString">
                    <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="[left] CodeControl z LeftQueryString"/>
                </ContentControl>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Expander Grid.Row="0"
                    x:Name="LeftInEdgesExpander"
                    Header="In edges"
                    IsExpanded="False"
                    Template="{StaticResource VertexCommanderHorizontalExpanderTemplate}"
                    Margin="0,0,0,3">
                        <StackPanel Orientation="Vertical" MinWidth="260">
                            <ComboBox x:Name="LeftInEdgesVisualiserSelector" MinWidth="250" Margin="0,0,0,2" SelectedIndex="0">
                                <ComboBoxItem Content="LeftInEdgesVisualiser: System\Meta\Visualiser\Class:{$Inherits:ShowesInEdges,BaseEdgeTarget:Any}"/>
                            </ComboBox>
                            <Border Style="{StaticResource SectionBorderStyle}" MinHeight="32">
                                <ContentControl x:Name="LeftInEdgesWrapVisualiser">
                                    <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="WrapVisualiser child Vertexes dla LeftInEdgesVisualiser"/>
                                </ContentControl>
                            </Border>
                        </StackPanel>
                </Expander>

                <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}">
                    <ContentControl x:Name="LeftInEdgesVisualiser">
                        <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="[left] visualizer wyswietlajacy InEdges dla LeftBaseEdge"/>
                    </ContentControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="2"
                Style="{StaticResource GripSplitterStyle}"
                Height="7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Row="3" Margin="0,3,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Expander Grid.Row="0"
                    x:Name="LeftOutEdgesExpander"
                    Header="Out edges"
                    IsExpanded="False"
                    Template="{StaticResource VertexCommanderHorizontalExpanderTemplate}"
                    Margin="0,0,0,3">
                        <StackPanel Orientation="Vertical" MinWidth="260">
                            <ComboBox x:Name="LeftOutEdgesVisualiserSelector" MinWidth="250" Margin="0,0,0,2" SelectedIndex="0">
                                <ComboBoxItem Content="LeftOutEdgesVisualiser: System\Meta\Visualiser\Class:{$Inherits:ShowesInEdges,BaseEdgeTarget:Any}"/>
                            </ComboBox>
                            <Border Style="{StaticResource SectionBorderStyle}" MinHeight="32">
                                <ContentControl x:Name="LeftOutEdgesWrapVisualiser">
                                    <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="WrapVisualiser child Vertexes dla LeftOutEdgesVisualiser"/>
                                </ContentControl>
                            </Border>
                        </StackPanel>
                </Expander>

                <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}">
                    <ContentControl x:Name="LeftOutEdgesVisualiser">
                        <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="[left] visualizer wyswietlajacy OutEdges dla LeftBaseEdge"/>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1"
            Style="{StaticResource GripSplitterStyle}"
            Width="7"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2" Margin="3,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="100"/>
                <RowDefinition Height="7"/>
                <RowDefinition Height="8*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionBorderStyle}" MinHeight="26" Margin="0,0,0,3">
                <ContentControl x:Name="RightQueryString">
                    <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="[right] CodeControl z RightQueryString"/>
                </ContentControl>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Expander Grid.Row="0"
                    x:Name="RightInEdgesExpander"
                    Header="In edges"
                    IsExpanded="False"
                    Template="{StaticResource VertexCommanderHorizontalExpanderTemplate}"
                    Margin="0,0,0,3">
                        <StackPanel Orientation="Vertical" MinWidth="260">
                            <ComboBox x:Name="RightInEdgesVisualiserSelector" MinWidth="250" Margin="0,0,0,2" SelectedIndex="0">
                                <ComboBoxItem Content="RightInEdgesVisualiser: System\Meta\Visualiser\Class:{$Inherits:ShowesInEdges,BaseEdgeTarget:Any}"/>
                            </ComboBox>
                            <Border Style="{StaticResource SectionBorderStyle}" MinHeight="32">
                                <ContentControl x:Name="RightInEdgesWrapVisualiser">
                                    <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="WrapVisualiser child Vertexes dla RightInEdgesVisualiser"/>
                                </ContentControl>
                            </Border>
                        </StackPanel>
                </Expander>

                <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}">
                    <ContentControl x:Name="RightInEdgesVisualiser">
                        <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="[right] visualizer wyswietlajacy InEdges dla RightBaseEdge"/>
                    </ContentControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="2"
                Style="{StaticResource GripSplitterStyle}"
                Height="7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Row="3" Margin="0,3,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Expander Grid.Row="0"
                    x:Name="RightOutEdgesExpander"
                    Header="Out edges"
                    IsExpanded="False"
                    Template="{StaticResource VertexCommanderHorizontalExpanderTemplate}"
                    Margin="0,0,0,3">
                        <StackPanel Orientation="Vertical" MinWidth="260">
                            <ComboBox x:Name="RightOutEdgesVisualiserSelector" MinWidth="250" Margin="0,0,0,2" SelectedIndex="0">
                                <ComboBoxItem Content="RightOutEdgesVisualiser: System\Meta\Visualiser\Class:{$Inherits:ShowesInEdges,BaseEdgeTarget:Any}"/>
                            </ComboBox>
                            <Border Style="{StaticResource SectionBorderStyle}" MinHeight="32">
                                <ContentControl x:Name="RightOutEdgesWrapVisualiser">
                                    <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="WrapVisualiser child Vertexes dla RightOutEdgesVisualiser"/>
                                </ContentControl>
                            </Border>
                        </StackPanel>
                </Expander>

                <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}">
                    <ContentControl x:Name="RightOutEdgesVisualiser">
                        <TextBlock Style="{StaticResource PlaceholderTextStyle}" Text="[right] visualizer wyswietlajacy OutEdges dla RightBaseEdge"/>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
