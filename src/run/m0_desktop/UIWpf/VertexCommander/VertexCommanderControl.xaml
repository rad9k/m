<UserControl x:Class="m0.UIWpf.VertexCommander.VertexCommanderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="520"
    d:DesignWidth="980"
    Background="{StaticResource 0BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{StaticResource 0VeryVeryLightForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource 0BackgroundBrush}"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="GripSplitterStyle" TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="{StaticResource 0GripBrush}"/>
            <Setter Property="ShowsPreview" Value="False"/>
        </Style>

        <Style x:Key="ExpanderHeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource 0ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="18,0,3,0"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VisualiserSelectorStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="MinWidth" Value="250"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="DisplayMemberPath" Value="Value"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryDropDownButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{StaticResource 0BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource 0ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource 0VeryVeryLightForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,0,0,0">
                            <Path x:Name="Arrow"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 0 0 L 7 0 L 3.5 4 Z"
                                Fill="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource 0VeryVeryLightForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomCommandButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource 0BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource 0ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource 0VeryVeryLightForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <ControlTemplate x:Key="VertexCommanderExpanderButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Rectangle Fill="Transparent"/>
                    <Ellipse x:Name="Circle"
                        Stroke="DarkGray"
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                    <Path x:Name="Arrow"
                        Data="M 1,1.5 L 4.5,5 8,1.5"
                        Stroke="#FF666666"
                        StrokeThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Arrow"
                                    Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                    To="180"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Arrow"
                                    Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                    To="0"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Stroke" Value="#FF3C7FB1" TargetName="Circle"/>
                    <Setter Property="Stroke" Value="#222" TargetName="Arrow"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="true">
                    <Setter Property="Stroke" Value="#FF526C7B" TargetName="Circle"/>
                    <Setter Property="StrokeThickness" Value="1.5" TargetName="Circle"/>
                    <Setter Property="Stroke" Value="#FF003366" TargetName="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="VertexCommanderHorizontalExpanderTemplate" TargetType="{x:Type Expander}">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton x:Name="ExpanderButton"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Margin="-3,0,0,0"
                    Template="{StaticResource VertexCommanderExpanderButtonTemplate}"
                    IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                    OverridesDefaultStyle="True"
                    Padding="1.5,0"/>
                <ContentPresenter x:Name="ExpanderContent"
                    Grid.Row="1"
                    ContentSource="Content"
                    ClipToBounds="True">
                    <ContentPresenter.LayoutTransform>
                        <ScaleTransform ScaleY="0"/>
                    </ContentPresenter.LayoutTransform>
                </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ExpanderContent"
                                    Storyboard.TargetProperty="(ContentPresenter.LayoutTransform).(ScaleTransform.ScaleY)"
                                    To="1"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ExpanderContent"
                                    Storyboard.TargetProperty="(ContentPresenter.LayoutTransform).(ScaleTransform.ScaleY)"
                                    To="0"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid Margin="3" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="7"/>
            <ColumnDefinition Width="*" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,3,0" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="100"/>
                <RowDefinition Height="7"/>
                <RowDefinition Height="8*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionBorderStyle}" Height="20" Margin="0,0,0,3">
                <Grid x:Name="LeftQueryHeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Column="0" x:Name="LeftQueryStringCodeControlHost" ClipToBounds="True"/>

                    <Button Grid.Column="1"
                        x:Name="LeftQueryHistoryToggle"
                        Style="{StaticResource HistoryDropDownButtonStyle}"
                        Click="LeftQueryHistoryToggle_Click"/>

                    <Popup
                        x:Name="LeftQueryHistoryPopup"
                        PlacementTarget="{Binding ElementName=LeftQueryHeaderGrid}"
                        Placement="Bottom"
                        Width="{Binding ActualWidth, ElementName=LeftQueryHeaderGrid}"
                        StaysOpen="False"
                        AllowsTransparency="True">
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <ListBox x:Name="LeftQueryHistoryList"
                                MaxHeight="200"
                                DisplayMemberPath="QueryText"
                                FontFamily="Consolas"
                                Background="{StaticResource 0BackgroundBrush}"
                                Foreground="{StaticResource 0ForegroundBrush}"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="LeftInEdgesSectionScrollViewer"
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                ClipToBounds="True">
                <StackPanel ClipToBounds="True">
                    <Grid ClipToBounds="True" Margin="0,0,0,3">
                        <Expander x:Name="LeftInEdgesExpander"
                            IsExpanded="False"
                            Template="{StaticResource VertexCommanderHorizontalExpanderTemplate}">
                            <Border
                                Style="{StaticResource SectionBorderStyle}"
                                MaxWidth="{Binding ViewportWidth, ElementName=LeftInEdgesSectionScrollViewer}"
                                MinHeight="32"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left">
                                <ContentControl
                                    x:Name="LeftInEdgesWrapVisualiserHost"
                                    MaxWidth="{Binding ViewportWidth, ElementName=LeftInEdgesSectionScrollViewer}"
                                    HorizontalAlignment="Left"
                                    ClipToBounds="True"/>
                            </Border>
                        </Expander>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1">
                            <TextBlock Style="{StaticResource ExpanderHeaderTextStyle}" Text="In edges"/>
                            <ComboBox x:Name="LeftInEdgesVisualiserSelector" Style="{StaticResource VisualiserSelectorStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <ContentControl
                            x:Name="LeftInEdgesVisualiserHost"
                            ClipToBounds="True"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Row="2"
                Style="{StaticResource GripSplitterStyle}"
                Height="7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext"/>

            <ScrollViewer
                x:Name="LeftOutEdgesSectionScrollViewer"
                Grid.Row="3"
                Margin="0,3,0,0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                ClipToBounds="True">
                <StackPanel ClipToBounds="True">
                    <Grid ClipToBounds="True" Margin="0,0,0,3">
                        <Expander x:Name="LeftOutEdgesExpander"
                            IsExpanded="False"
                            Template="{StaticResource VertexCommanderHorizontalExpanderTemplate}">
                            <Border
                                Style="{StaticResource SectionBorderStyle}"
                                MaxWidth="{Binding ViewportWidth, ElementName=LeftOutEdgesSectionScrollViewer}"
                                MinHeight="32"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left">
                                <ContentControl
                                    x:Name="LeftOutEdgesWrapVisualiserHost"
                                    MaxWidth="{Binding ViewportWidth, ElementName=LeftOutEdgesSectionScrollViewer}"
                                    HorizontalAlignment="Left"
                                    ClipToBounds="True"/>
                            </Border>
                        </Expander>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1">
                            <TextBlock Style="{StaticResource ExpanderHeaderTextStyle}" Text="Out edges"/>
                            <ComboBox x:Name="LeftOutEdgesVisualiserSelector" Style="{StaticResource VisualiserSelectorStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <ContentControl
                            x:Name="LeftOutEdgesVisualiserHost"
                            ClipToBounds="True"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="0"
            Grid.Column="1"
            Style="{StaticResource GripSplitterStyle}"
            Width="7"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Row="0" Grid.Column="2" Margin="3,0,0,0" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="100"/>
                <RowDefinition Height="7"/>
                <RowDefinition Height="8*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionBorderStyle}" Height="20" Margin="0,0,0,3">
                <Grid x:Name="RightQueryHeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Column="0" x:Name="RightQueryStringCodeControlHost" ClipToBounds="True"/>

                    <Button Grid.Column="1"
                        x:Name="RightQueryHistoryToggle"
                        Style="{StaticResource HistoryDropDownButtonStyle}"
                        Click="RightQueryHistoryToggle_Click"/>

                    <Popup
                        x:Name="RightQueryHistoryPopup"
                        PlacementTarget="{Binding ElementName=RightQueryHeaderGrid}"
                        Placement="Bottom"
                        Width="{Binding ActualWidth, ElementName=RightQueryHeaderGrid}"
                        StaysOpen="False"
                        AllowsTransparency="True">
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <ListBox x:Name="RightQueryHistoryList"
                                MaxHeight="200"
                                DisplayMemberPath="QueryText"
                                FontFamily="Consolas"
                                Background="{StaticResource 0BackgroundBrush}"
                                Foreground="{StaticResource 0ForegroundBrush}"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="RightInEdgesSectionScrollViewer"
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                ClipToBounds="True">
                <StackPanel ClipToBounds="True">
                    <Grid ClipToBounds="True" Margin="0,0,0,3">
                        <Expander x:Name="RightInEdgesExpander"
                            IsExpanded="False"
                            Template="{StaticResource VertexCommanderHorizontalExpanderTemplate}">
                            <Border
                                Style="{StaticResource SectionBorderStyle}"
                                MaxWidth="{Binding ViewportWidth, ElementName=RightInEdgesSectionScrollViewer}"
                                MinHeight="32"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left">
                                <ContentControl
                                    x:Name="RightInEdgesWrapVisualiserHost"
                                    MaxWidth="{Binding ViewportWidth, ElementName=RightInEdgesSectionScrollViewer}"
                                    HorizontalAlignment="Left"
                                    ClipToBounds="True"/>
                            </Border>
                        </Expander>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1">
                            <TextBlock Style="{StaticResource ExpanderHeaderTextStyle}" Text="In edges"/>
                            <ComboBox x:Name="RightInEdgesVisualiserSelector" Style="{StaticResource VisualiserSelectorStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <ContentControl
                            x:Name="RightInEdgesVisualiserHost"
                            ClipToBounds="True"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Row="2"
                Style="{StaticResource GripSplitterStyle}"
                Height="7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext"/>

            <ScrollViewer
                x:Name="RightOutEdgesSectionScrollViewer"
                Grid.Row="3"
                Margin="0,3,0,0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                ClipToBounds="True">
                <StackPanel ClipToBounds="True">
                    <Grid ClipToBounds="True" Margin="0,0,0,3">
                        <Expander x:Name="RightOutEdgesExpander"
                            IsExpanded="False"
                            Template="{StaticResource VertexCommanderHorizontalExpanderTemplate}">
                            <Border
                                Style="{StaticResource SectionBorderStyle}"
                                MaxWidth="{Binding ViewportWidth, ElementName=RightOutEdgesSectionScrollViewer}"
                                MinHeight="32"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left">
                                <ContentControl
                                    x:Name="RightOutEdgesWrapVisualiserHost"
                                    MaxWidth="{Binding ViewportWidth, ElementName=RightOutEdgesSectionScrollViewer}"
                                    HorizontalAlignment="Left"
                                    ClipToBounds="True"/>
                            </Border>
                        </Expander>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1">
                            <TextBlock Style="{StaticResource ExpanderHeaderTextStyle}" Text="Out edges"/>
                            <ComboBox x:Name="RightOutEdgesVisualiserSelector" Style="{StaticResource VisualiserSelectorStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <ContentControl
                            x:Name="RightOutEdgesVisualiserHost"
                            ClipToBounds="True"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border
            x:Name="BottomCommandBar"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="0,2,0,0"
            BorderBrush="{StaticResource 0VeryVeryLightForegroundBrush}"
            BorderThickness="1"
            Background="{StaticResource 0BackgroundBrush}"
            ClipToBounds="True">
            <UniformGrid x:Name="BottomCommandButtonsGrid" Rows="1" Columns="10" ClipToBounds="True">
                <Button x:Name="ViewButton" Style="{StaticResource BottomCommandButtonStyle}" Click="ViewButton_Click" Content="F3 View"/>
                <Button x:Name="EditButton" Style="{StaticResource BottomCommandButtonStyle}" Click="EditButton_Click" Content="F4 Edit"/>
                <Button x:Name="CopyButton" Style="{StaticResource BottomCommandButtonStyle}" Click="CopyButton_Click" Content="F5 Copy"/>
                <Button x:Name="MoveButton" Style="{StaticResource BottomCommandButtonStyle}" Click="MoveButton_Click" Content="F6 Move"/>
                <Button x:Name="NewVertexButton" Style="{StaticResource BottomCommandButtonStyle}" Click="NewVertexButton_Click" Content="F7 New Vertex"/>
                <Button x:Name="DeleteButton" Style="{StaticResource BottomCommandButtonStyle}" Click="DeleteButton_Click" Content="F8 Delete"/>
                <Button x:Name="NewEdgeButton" Style="{StaticResource BottomCommandButtonStyle}" Click="NewEdgeButton_Click" Content="F9 New Edge"/>
                <Button x:Name="ReplaceButton" Style="{StaticResource BottomCommandButtonStyle}" Click="ReplaceButton_Click" Content="F10 Replace"/>
                <Button x:Name="MasterToDetailButton" Style="{StaticResource BottomCommandButtonStyle}" Click="MasterToDetailButton_Click" Content="F11 Master -&gt; Detail"/>
                <Button x:Name="DetailToMasterButton" Style="{StaticResource BottomCommandButtonStyle}" Click="DetailToMasterButton_Click" Content="F12 Detail &lt;- Master"/>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
