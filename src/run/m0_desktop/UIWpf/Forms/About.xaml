<Window x:Class="m0.UIWpf.Forms.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:m0.UIWpf.Forms"
        mc:Ignorable="d"
        Title="about" Height="188" Width="488" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="ToolWindow">
    <Grid Margin="4,2,8,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Viewport3D x:Name="LogoView" Grid.Column="0" Margin="0,0,4,0" ClipToBounds="True"/>
        <DockPanel Grid.Column="1" Margin="6,2,0,0">
            <Button DockPanel.Dock="Bottom" Content="OK" HorizontalAlignment="Right" Height="24" Width="72" Margin="0,6,0,0" Click="Button_Click"/>
            <StackPanel>
                <TextBlock Text="minus zero 1.0" FontSize="20" Margin="0,0,0,1"/>
                <TextBlock Text="PUBLIC DOMAIN software by Radosław Tereszczuk" FontSize="12"/>
                <TextBlock FontSize="12" Margin="0,2,0,0">
                    <Hyperlink NavigateUri="http://tereszczuk.com" RequestNavigate="WebsiteHyperlink_RequestNavigate">tereszczuk.com</Hyperlink>
                </TextBlock>
                <TextBlock Text="you will die. someday. remember" FontSize="12" FontStyle="Italic" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
